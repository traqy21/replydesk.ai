aws_region       = "us-east-1"
app_name         = "replydesk-ai"
openai_api_key   = "sk-your-openai-api-key-here"
instance_type    = "t4g.micro"                        # ~$6/month — recommended minimum
ssh_public_key   = "ssh-rsa AAAA... your-public-key"  # paste contents of ~/.ssh/id_rsa.pub
ssh_allowed_cidr = "YOUR_IP/32"                       # restrict SSH to your IP
domain           = "app.yourdomain.com"               # point A record to elastic_ip after deploy
ses_sender_email = "noreply@yourdomain.com"
admin_email      = "admin@yourdomain.com"
admin_password   = "change-me-before-deploy"
github_repo      = "your-github-username/replydesk-ai"
app_url          = "https://app.yourdomain.com"       # update after first deploy
log_retention_days = 30
