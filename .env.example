OPENAI_API_KEY=your_openai_api_key_here

# Session persistence — change this to a long random string in production
SESSION_SECRET=change-this-to-a-random-secret

# Email provider: "resend" (default) or "ses"
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here

# Default admin account — created on first startup if not already present
# Change these before deploying to production
ADMIN_EMAIL=admin@replydesk.ai
ADMIN_PASSWORD=change_me_before_deploy
